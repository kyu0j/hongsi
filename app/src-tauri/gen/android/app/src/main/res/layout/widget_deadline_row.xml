<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:id="@+id/widget_row_root" android:paddingBottom="4dp">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/deadline_frame" android:src="@drawable/widget_deadline_frame" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/deadline_accent" android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:layout_marginStart="1dp" android:src="@drawable/widget_class_accent" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/deadline_kind" android:layout_width="15dp" android:layout_height="15dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:id="@+id/row_title" android:textSize="16sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/row_subtitle" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/row_deadline" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/row_status" android:textSize="13sp" android:textColor="@color/widget_badge_warn_text" android:includeFontPadding="false" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginStart="6dp" android:maxWidth="104dp" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:background="@drawable/widget_badge_warn" />
    <TextView android:layout_width="54dp" android:layout_height="wrap_content" android:id="@+id/row_badge" android:textSize="14sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:gravity="center" android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
