<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_row_root">
  <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:id="@+id/row_separator" android:background="@color/widget_border" android:importantForAccessibility="no" />
  <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:id="@+id/row_accent" android:src="@drawable/widget_class_accent" android:scaleType="fitXY" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/row_content" android:minHeight="64dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
    <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:id="@+id/row_time" android:text="@string/widget_preview_time_1000" android:textSize="15sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:gravity="center_vertical" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/row_title" android:text="@string/widget_preview_linear_algebra" android:textSize="14.5sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/row_subtitle" android:text="@string/widget_preview_room_c819" android:textSize="12.5sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_badges" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:layout_marginStart="6dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/row_badge" android:text="@string/widget_status_scheduled" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:background="@drawable/widget_badge_muted" android:layout_marginStart="6dp" />
  </LinearLayout>
</FrameLayout>