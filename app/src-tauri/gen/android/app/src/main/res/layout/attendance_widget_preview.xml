<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="17dp" android:background="@drawable/widget_attendance_active" android:orientation="vertical" android:baselineAligned="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="12dp" android:baselineAligned="false">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_attendance_heading" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_app_primary_text" android:includeFontPadding="false" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/widget_app_text" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="2" android:ellipsize="end" android:text="@string/widget_preview_math" />
    </LinearLayout>
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/widget_action_refresh">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_app_muted" android:importantForAccessibility="no" />
      <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:indeterminate="true" android:indeterminateDrawable="@drawable/widget_refresh_spin" android:indeterminateTint="@color/widget_app_muted" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:orientation="vertical" android:gravity="center_vertical" android:layout_weight="1" android:baselineAligned="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
          <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_attendance_dot" android:importantForAccessibility="no" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12.5sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_app_primary_text" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:text="@string/widget_attendance_available" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_app_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:text="@string/widget_preview_attendance_detail" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_attendance_auto_check" android:textSize="12sp" android:textColor="@color/widget_app_muted" android:includeFontPadding="false" android:layout_marginTop="5dp" android:visibility="gone" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="12dp" android:paddingHorizontal="14dp" android:drawableStart="@drawable/ic_widget_tick_on_primary" android:drawablePadding="6dp" android:text="@string/widget_action_attend" android:textSize="15sp" android:textColor="@color/widget_app_on_primary" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/widget_attendance_primary" android:visibility="visible" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:paddingHorizontal="9dp" android:paddingVertical="7dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_attendance_badge_muted" android:visibility="gone" android:baselineAligned="false">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_app_muted" android:includeFontPadding="false" android:maxLines="1" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>