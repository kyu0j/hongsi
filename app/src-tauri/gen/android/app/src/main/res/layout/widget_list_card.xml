<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_attendance_background" android:id="@+id/widget_list_root">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/widget_title" android:text="@string/widget_today_heading" android:textSize="20sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
    <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:id="@+id/widget_refresh" android:contentDescription="@string/widget_action_refresh">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/refresh_icon" android:padding="11dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_muted" android:importantForAccessibility="no" />
      <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/refresh_spinner" android:padding="10dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_refresh_spin" android:indeterminateTint="@color/widget_muted" android:indeterminateDuration="650" android:interpolator="@android:anim/linear_interpolator" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/widget_body" />
  <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:gravity="center" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
